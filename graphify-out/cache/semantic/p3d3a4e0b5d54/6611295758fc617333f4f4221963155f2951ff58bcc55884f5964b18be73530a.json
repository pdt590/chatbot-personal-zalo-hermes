{"nodes": [{"id": "readme_hermes_zalo_plugin", "label": "hermes-zalo-plugin (README)", "file_type": "document", "source_file": "README.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_zca_js", "label": "zca-js (unofficial personal Zalo API)", "file_type": "concept", "source_file": "README.md", "source_location": "L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over unofficial Python Zalo clients because it is more actively maintained, tracks Zalo protocol changes, and exposes a richer 145-method API; the cost (TypeScript vs Python Hermes) is paid by a thin Node bridge."}, {"id": "readme_hermes_agent", "label": "Hermes Agent gateway", "file_type": "concept", "source_file": "README.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_node_bridge", "label": "Node.js bridge (server.js)", "file_type": "concept", "source_file": "README.md", "source_location": "L19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Thin Node bridge exists to cross the language gap between TypeScript zca-js and the Python Hermes agent."}, {"id": "readme_hermes_zalo_adapter", "label": "Hermes Zalo platform adapter (hermes-plugin/)", "file_type": "concept", "source_file": "README.md", "source_location": "L246", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bundled and auto-installed into ~/.hermes/plugins/zalo/ with zalo-platform enabled in config.yaml so users need not place files manually."}, {"id": "readme_sse_events_stream", "label": "SSE /events stream with Last-Event-ID replay", "file_type": "rationale", "source_file": "README.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Heartbeat every 15s plus ring-buffer replay via Last